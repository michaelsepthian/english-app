# Copy to .env. The existing local backend/.env already contains database credentials.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=toko
DB_USER=english_app
DB_PASSWORD=replace-with-dedicated-role-password
DB_SSLMODE=disable
HTTP_ADDR=:8080
APP_ORIGIN=http://localhost:5180
COOKIE_SECURE=false
STATIC_DIR=../frontend/dist
ALLOW_REGISTRATION=true

# API-key configuration for the selected OpenAI-compatible endpoint.
AI_BASE_URL=https://member.vpsindonesia.co.id/api/v1
AI_API_KEY=
AI_MODEL=sonnet-5
AI_API_FORMAT=chat_completions
# prompt is broadly compatible; explicit alternatives: json_object or json_schema.
AI_JSON_MODE=prompt
AI_DAILY_LIMIT=120

# Listening and dictation always use browser/device services.

# Optional acoustic pronunciation assessment. Without these, reading checks word matching only.
AZURE_SPEECH_KEY=
# Resource endpoint, e.g. https://your-resource.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=
