# Copy to deploy/.env on the VPS; never commit real values.
APP_ORIGIN=https://miva.example.com
COOKIE_SECURE=true
ALLOW_REGISTRATION=false
# Existing PostgreSQL; no new database container is created.
DB_HOST=host.docker.internal
DB_PORT=55432
DB_NAME=toko
DB_USER=english_app
DB_PASSWORD=replace-with-your-dedicated-password
DB_SSLMODE=disable
# For a PostgreSQL container on Linux, prefer its existing Docker network:
# DB_NETWORK=toko_default
# DB_HOST=toko-postgres-1
# DB_PORT=5432
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5180
POSTGRES_TOOLS_IMAGE=postgres:18-alpine
AI_BASE_URL=https://member.vpsindonesia.co.id/api/v1
AI_API_KEY=
AI_MODEL=sonnet-5
AI_API_FORMAT=chat_completions
AI_JSON_MODE=prompt
AI_DAILY_LIMIT=120
# Optional acoustic pronunciation:
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=
