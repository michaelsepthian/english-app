FROM golang:1.26-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /miva .
FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata && addgroup -S miva && adduser -S miva -G miva
WORKDIR /app
COPY --from=build /miva /app/miva
ENV HTTP_ADDR=:8080 TZ=Asia/Jakarta MIGRATE_ON_START=false
USER miva
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/app/miva"]
CMD ["serve"]
