{
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "es5",
  "plugins": ["./frontend/node_modules/prettier-plugin-svelte/plugin.js"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte",
        "svelteSortOrder": "options-scripts-markup-styles"
      }
    }
  ],
  "htmlWhitespaceSensitivity": "ignore"
}
